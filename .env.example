# ---------------------------------------------------------------
# MongoDB — use the NON-SRV (standard) connection string.
# It starts with  mongodb://  (NOT mongodb+srv://)
#
# MongoDB Atlas: Connect -> Drivers -> Node.js -> choose
# "2.2.12 or later" as the version to get the non-SRV string.
# If your password has special characters (@ : / ? # %) URL-encode them.
# ---------------------------------------------------------------
MONGODB_URI=mongodb://USER:PASSWORD@host1:27017,host2:27017,host3:27017/rudraksha?ssl=true&replicaSet=atlas-xxxxxx-shard-0&authSource=admin&retryWrites=true&w=majority
# Local MongoDB example:
# MONGODB_URI=mongodb://127.0.0.1:27017/rudraksha

# Admin panel login (/admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password

# Long random string used to sign the admin session cookie
# generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Your live site URL (used for sitemap / SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional — online payments (UPI / cards / netbanking) via Razorpay.
# Leave empty to run Cash on Delivery only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
